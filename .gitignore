# ===== 构建产物 =====
build/
build-debug/
out/
cmake-build-*/

# ===== 发布/分发目录（含外部 DLL、皮肤、示例，体积大且机器相关）=====
dist/
优化版本/
优化版本-Win7/
release/
publish/

# ===== 编译缓存/中间产物 =====
*.o
*.obj
*.exe
*.dll
*.ilk
*.pdb
*.exp
*.lib
generated/

# ===== 资源/素材（入库：源码 + 素材）=====
# 素材目录纳入版本管理；其中系统运行库(dll，已被下方 *.dll 排除)与 swiftshader ICD 配置(json)仍排除
资源/*.json
# 编译产物着色器(spv)不入库（着色器源在 src/shaders/*.vert/.frag）
*.spv

# ===== 系统/IDE 无关文件 =====
*.reg
*.log
.DS_Store
Thumbs.db

# ===== WorkBuddy 本地状态（不入库）=====
.workbuddy/

# ===== Python/脚本缓存 =====
__pycache__/
*.pyc

# ===== 临时文件 =====
*.tmp
*.bak
*.old
awa_old.exe

# ===== git-sync 同步工具（不入库，用户 2026-08-22 要求）=====
git-sync/
